{
  "name": "cryptofolio-mcp",
  "version": "0.1.0",
  "description": "MCP server for cryptofolio — LLM-driven crypto portfolio management",
  "type": "module",
  "bin": {
    "cryptofolio-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "CRYPTOFOLIO_INTEGRATION=1 vitest run tests/integration",
    "lint": "eslint src/ tests/ evals/",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:mock": "tsx evals/run.ts --mock",
    "eval:typecheck": "tsc -p evals/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "execa": "^9.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.62.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
